# Get a token from @BotFather on Telegram
BOT_TOKEN=123456:ABC-your-token-here

# Comma-separated Telegram numeric user IDs allowed to control this PC.
# Find yours by messaging @userinfobot. ANYONE NOT LISTED IS IGNORED.
ALLOWED_USER_IDS=111111111

# Max seconds a shell command may run before being killed
SHELL_TIMEOUT=60

# Folder where files you send to the bot are saved
UPLOAD_DIR=C:\Users\Public\Downloads\TelegramUploads

# ---- Edith brain --------------------------------------------------------
# LLM_PROVIDER=anthropic (Claude, paid) or openai_compat (Ollama/Gemini/Groq/OpenRouter, free tiers)
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
# For openai_compat, e.g. local Ollama: LLM_BASE_URL=http://localhost:11434/v1  LLM_MODEL=qwen3:8b
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# ---- Voice -----------------------------------------------------------------
WHISPER_MODEL=small
TTS_VOICE=en-GB-SoniaNeural

# ---- Automations (optional) ----------------------------------------------
# AUTOMATION_DB=data\automation.db
# AUTOMATION_POLL_SECONDS=30
